{
  "manifest_version": 2,
  "name": "MacShell Browser Tools",
  "version": "0.1.0",
  "description": "Local tab topics, website watches and structured page customization for MacShell.",
  "browser_specific_settings": {"gecko": {"id": "browser-tools@macshell.local", "strict_min_version": "128.0"}},
  "permissions": ["tabs", "storage", "alarms", "notifications", "activeTab"],
  "optional_permissions": ["<all_urls>"],
  "background": {"scripts": ["background.js"]},
  "browser_action": {"default_title": "MacShell Browser Tools", "default_popup": "panel.html"},
  "icons": {"48": "icon.svg"}
}
