[Desktop Entry]
Type=Application
Name=Files
Name[id]=Berkas
Comment=Browse files with MacShell window controls
Exec="@BIN_DIR@/macshell-nautilus" --new-window %U
Icon=org.gnome.Nautilus
Terminal=false
DBusActivatable=false
Categories=GNOME;GTK;Utility;Core;FileManager;
MimeType=inode/directory;
StartupNotify=true
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec="@BIN_DIR@/macshell-nautilus" --new-window
