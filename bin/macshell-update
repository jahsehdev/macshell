#!/usr/bin/env python3
"""Update this bundle from its own Git remote, preserving installer backups."""
import json
import os
from pathlib import Path
import subprocess
import sys

state = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state')))
manifest = json.loads((state / 'macshell/installer/manifest.json').read_text())
source = Path(manifest['source'])
if not (source / '.git').is_dir():
    raise SystemExit('Keep a git clone of your MacShell repository to use updates.')
mode = sys.argv[1] if len(sys.argv) > 1 else 'update'
if mode in ('check', '--check'):
    subprocess.run(['git', '-C', str(source), 'fetch', '--quiet'], check=True)
    ahead = subprocess.check_output(['git', '-C', str(source), 'rev-list', '--count', 'HEAD..@{u}'], text=True).strip()
    print('update available' if int(ahead) else 'up to date')
    raise SystemExit(10 if int(ahead) else 0)
if mode not in ('update', '--update', 'install'):
    raise SystemExit('Usage: macshell-update [check|update]')
subprocess.run(['git', '-C', str(source), 'pull', '--ff-only'], check=True)
os.execv('/usr/bin/bash', ['bash', str(source / 'install.sh'), *sys.argv[2:]])
