#!/usr/bin/env python3
"""Apply the saved Typography selection to native apps without resetting its style."""
import os
from pathlib import Path
import runpy

config = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
helper = config / "quickshell/Common/sync_fonts.py"
if not helper.is_file():
    helper = Path(__file__).resolve().parents[1] / "config/quickshell/Common/sync_fonts.py"
runpy.run_path(str(helper), run_name="__main__")
