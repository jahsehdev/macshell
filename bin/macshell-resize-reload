#!/bin/sh
set -eu
plugin="${XDG_DATA_HOME:-$HOME/.local/share}/macshell/fullscreen-lock/fullscreen-lock.so"
if [ ! -r "$plugin" ]; then
    printf '%s\n' 'Plugin resize MacShell tidak ditemukan.' >&2
    exit 1
fi
# Unload the existing hook before loading the rebuilt library at the same path.
# A config reload alone can leave the already-loaded plugin version in memory.
result=$(hyprctl plugin unload "$plugin" 2>&1) || {
    printf '%s\n' "$result" >&2
    exit 1
}
if [ "$result" != 'ok' ]; then
    printf '%s\n' "$result" >&2
    exit 1
fi
result=$(hyprctl plugin load "$plugin" 2>&1) || {
    printf '%s\n' "$result" >&2
    exit 1
}
if [ "$result" != 'ok' ]; then
    printf '%s\n' "$result" >&2
    exit 1
fi
printf '%s\n' 'Resize manual untuk jendela Dock Never hide sudah diaktifkan.'
