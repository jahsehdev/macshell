#!/usr/bin/env python3
"""Use the bundled terminal, with GNOME Console as a startup fallback."""
import os
from pathlib import Path
import shutil
import sys

args = sys.argv[1:]
while args and args[0] in ('--dir', '--working-directory', '--workingDirectory'):
    if len(args) < 2:
        raise SystemExit('A working directory is required')
    os.chdir(args[1])
    args = args[2:]
if args[:1] in (['--execute'], ['--command'], ['--']):
    args = ['-e', *args[1:]]
binary = Path.home() / '.local/bin/tahoe-terminal'
executable = str(binary) if binary.exists() else shutil.which('kgx')
if not executable:
    raise SystemExit('Run the complete MacShell installer to build Tahoe Terminal.')
os.execv(executable, [executable, *args])
