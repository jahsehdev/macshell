#!/usr/bin/env python3
"""Open GNOME Console with MacShell working-directory and command arguments."""
import os
import shutil
import sys

args = sys.argv[1:]
while args and args[0] in ('--dir', '--working-directory', '--workingDirectory'):
    if len(args) < 2:
        raise SystemExit('A working directory is required')
    os.chdir(args[1])
    args = args[2:]
if args[:1] in (['--execute'], ['--command'], ['--']):
    args = ['-e', *args[1:]]
executable = shutil.which('kgx')
if not executable:
    raise SystemExit('GNOME Console (kgx) is missing. Install the gnome-console package.')
os.execv(executable, [executable, *args])
